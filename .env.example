# Copied/managed by scripts/sync-env.mjs after `supabase start` — these three
# always reflect the running local stack (hosted values at migration time):
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=see-supabase-status
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Owner bootstrap (scripts/create-owner.mjs)
OWNER_EMAIL=you@example.com
# OWNER_PASSWORD=set-to-rotate

# --- future phases -----------------------------------------------------------
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# ANTHROPIC_API_KEY=
# ALPACA_KEY_ID=            # PAPER keys until Phase 3 sign-off
# ALPACA_SECRET_KEY=
# Paper vs live is NOT decided here — it is agent_config.execution_mode, which
# defaults to paper and has to be changed by hand. These are simply the keys
# for whichever endpoint that selects, so use paper keys until sign-off.
#
# Nothing executes until the caps in agent_config are raised from their
# defaults of 0: max_txn_amount, max_daily_amount, max_position_size,
# max_open_positions, and allowed_action_types must include 'trade'. A fresh
# install refuses every order, which is the intended starting state.
# KALSHI_API_KEY_ID=        # demo environment first
# KALSHI_PRIVATE_KEY_PATH=

# Push notifications (recaps, receipt alerts, watchlist hits) via ntfy.sh.
# The topic IS the credential: anyone who knows the string can read every
# notification you receive, so generate a random one rather than a memorable
# one and treat it like a password.
#   NTFY_TOPIC=lifecmd-$(openssl rand -hex 16)
# Subscribe to the same topic in the ntfy app on your phone.
# NTFY_TOPIC=
