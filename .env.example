# Copied/managed by scripts/sync-env.mjs after `supabase start` — these three
# always reflect the running local stack (hosted values at migration time):
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=see-supabase-status
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Owner bootstrap (scripts/create-owner.mjs)
OWNER_EMAIL=you@example.com
# OWNER_PASSWORD=set-to-rotate

