{
  "name": "finance-dashboard",
  "private": true,
  "version": "0.1.0",
  "description": "Personal AI finance platform — local-first build",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "workers": "npm run start -w apps/worker",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts",
    "env:sync": "node scripts/sync-env.mjs",
    "owner:create": "node scripts/create-owner.mjs",
    "svc:install": "bash scripts/install-services.sh",
    "svc:start": "systemctl --user start finance-supabase finance-web finance-workers",
    "svc:stop": "systemctl --user stop finance-web finance-workers",
    "svc:restart": "systemctl --user restart finance-web finance-workers",
    "svc:status": "systemctl --user --no-pager status finance-supabase finance-web finance-workers",
    "svc:logs": "journalctl --user -f -u finance-web -u finance-workers",
    "up": "bash scripts/startup.sh"
  },
  "devDependencies": {
    "supabase": "^2.0.0",
    "typescript": "^5.6.2"
  }
}
