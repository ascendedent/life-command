# Template — installed by scripts/install-services.sh (placeholders substituted).
[Unit]
Description=Finance Dashboard — Next.js web app (port 3141)
After=finance-supabase.service
Wants=finance-supabase.service

[Service]
WorkingDirectory=@ROOT@
Environment=NODE_ENV=production
Environment=PORT=3141
# The browser sends every auth cookie it has accumulated for this origin,
# and Node rejects the whole request with a bare 431 once they exceed 16KB.
# Stale sessions from the era when the cookie was named after the URL push
# it past that, so the ceiling is raised rather than left to chance.
Environment=NODE_OPTIONS=--max-http-header-size=32768
ExecStart=@NODE@ scripts/launch-web.js
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
