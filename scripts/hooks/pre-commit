#!/usr/bin/env bash
# Refuse to commit personal data.
#
# This repository is public. Real specifics kept leaking into comments and
# commit messages because concrete examples explain a bug better than abstract
# ones — a landlord's name, a third party on a P2P transfer, account masks,
# actual balances. The examples should stay concrete and stop being real.
#
# Instance-specific names live in .pii-denylist, which is gitignored: the list
# of things you must not publish is itself something you must not publish.
#
#   echo "Some Person" >> .pii-denylist
#
# Bypass for a genuine false positive:  git commit --no-verify
set -uo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0
added=$(git diff --cached -U0 -- $staged | grep '^+' | grep -v '^+++' || true)
[ -z "$added" ] && exit 0

if ! printf '%s' "$added" | "$(dirname "$0")/pii-scan"; then
  echo
  echo "Commit blocked: the staged changes look like personal data."
  echo "This repository is public — use an invented example instead."
  echo "If it is genuinely a false positive: git commit --no-verify"
  exit 1
fi
exit 0
